import matplotlib.pyplot as plt
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
data = pd.DataFrame({
'Income': [15, 16, 17, 18, 20, 60, 62, 65, 70, 72, 90, 92, 95, 98, 100],
'Spending': [80, 85, 78, 82, 75, 40, 45, 42, 35, 38, 15, 20, 18, 12, 10]
})
scaler = StandardScaler()
X = scaler.fit_transform(data)
model = KMeans(n_clusters=3, random_state=42, n_init=10)
data['Cluster'] = model.fit_predict(X)
print(data)
plt.scatter(data['Income'], data['Spending'],
c=data['Cluster'], cmap='viridis', s=100)
plt.xlabel("Annual Income (in thousands)")
plt.ylabel("Spending Score")
plt.title("K-Means Customer Clustering")
plt.show()
